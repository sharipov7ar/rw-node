# Copy to /etc/rw-node/rw-node.env (chmod 600). Never commit real values.
BASE_DOMAIN=metall3.ru
ENTRY_STEAL_TAG=RUS2-Steal
NGINX_CONFIG=/opt/remnawave/nginx.conf
COMPOSE_DIR=/opt/remnawave
PROFILE_JSON=/opt/remnawave/rw-node/profile.json
# Optional: enables applying the generated profile through the Remnawave API.
PANEL_URL=https://panel.example.com
PANEL_TOKEN=
PROFILE_UUID=
CERTBOT_CERT_NAME=metall3.ru
